# Copiar estas variables a Coolify. No usar este archivo como env_file.
# Reemplazar los cuatro secretos y CHAT_ID antes de desplegar.

# Secretos: marcar como "Secret" y sólo "Runtime" en Coolify.
TELEGRAM_BOT_TOKEN=REEMPLAZAR_TOKEN_TELEGRAM
SESSION_ENCRYPTION_KEY=REEMPLAZAR_CLAVE_FERNET
ARCA_CERTIFICATE_B64=REEMPLAZAR_CERTIFICADO_BASE64
ARCA_PRIVATE_KEY_B64=REEMPLAZAR_CLAVE_PRIVADA_BASE64

# Identidad y autorización personal.
BOT_ALLOWED_CHAT_IDS=CHAT_ID
CCMA_CHAT_IDS=CHAT_ID
INVOICE_EMISSION_CHAT_IDS=CHAT_ID
IIBB_PAYMENT_CHAT_IDS=CHAT_ID
ARCA_ENVIRONMENT=production
ARCA_OPERATOR_CUIT=20383717419
ARCA_CERTIFICATE_ALIAS=simplearcaprod
ARCA_WSFE_POINT_OF_SALE=2
INVOICE_ISSUER_IIBB=20383717419

# Servicios activos.
CCMA_ENABLED=true
ARCA_SETI_ENABLED=true
SANTA_FE_IIBB_ENABLED=true
IIBB_PAYMENTS_ENABLED=true
AUTOMATIC_MONITOR_ENABLED=true
ARCA_ENROLLMENT_ENABLED=true

# Winston / Tailscale. 8090 no se usa porque está ocupado por Beszel.
TAILSCALE_BIND_IP=100.75.19.73
ARCA_ENROLLMENT_HOST_PORT=8091
CCMA_NOVNC_HOST_PORT=6080
ARCA_ENROLLMENT_BASE_URL=http://winston.tail98a73b.ts.net:8091
ARCA_ENROLLMENT_ALLOW_TAILSCALE_HTTP=true
CCMA_LOGIN_URL=http://winston.tail98a73b.ts.net:6080/vnc.html?autoconnect=true&resize=scale

# Intervalos recomendados.
CCMA_SYNC_INTERVAL_SECONDS=21600
CCMA_SNAPSHOT_TTL_SECONDS=86400
ARCA_SETI_SNAPSHOT_TTL_SECONDS=86400
SANTA_FE_IIBB_SNAPSHOT_TTL_SECONDS=86400
AUTOMATIC_MONITOR_CHECK_SECONDS=300
AUTOMATIC_SYNC_INTERVAL_SECONDS=21600
CCMA_BROWSER_HEADLESS=true
LOG_LEVEL=INFO
