# Crear una copia llamada .env y completar los dos valores.
TELEGRAM_BOT_TOKEN=
# Lista global de chats autorizados. El bot ignora cualquier otro chat o grupo.
BOT_ALLOWED_CHAT_IDS=

# Opcionales
TAX_MONITOR_DB=./data/tax_monitor_v2.sqlite3
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://tributario.example.com
SESSION_ENCRYPTION_KEY=
# Generar una vez con:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Alternativa recomendada para Docker (no configurar ambas):
# SESSION_ENCRYPTION_KEY_FILE=/run/secrets/session_encryption.key

# ARCA Web Services. Empezar siempre en homologación.
ARCA_ENVIRONMENT=homologation
ARCA_OPERATOR_CUIT=
ARCA_CERTIFICATE_ALIAS=
ARCA_CERTIFICATE_PATH=/run/secrets/arca.crt
ARCA_PRIVATE_KEY_PATH=/run/secrets/arca.key

# Facturación WSFE. El punto debe ser exclusivo de Webservices; nunca usar 00001.
ARCA_WSFE_POINT_OF_SALE=
# Lista de chats autorizados a emitir, separados por coma. Vacío bloquea toda emisión.
INVOICE_EMISSION_CHAT_IDS=
# En Santa Fe normalmente coincide con el CUIT para Régimen Simplificado.
INVOICE_ISSUER_IIBB=

# Cuenta corriente de Monotributo. El navegador queda aislado en portal-worker.
CCMA_ENABLED=false
CCMA_CHAT_IDS=
CCMA_SYNC_INTERVAL_SECONDS=21600
CCMA_SNAPSHOT_TTL_SECONDS=86400
# El login usa HTTPS directo; la lectura automatizada de CCMA puede ser headless.
CCMA_BROWSER_HEADLESS=true
# URL privada del noVNC, si se publica detrás de un acceso seguro.
CCMA_LOGIN_URL=
SANTA_FE_IIBB_ENABLED=true
SANTA_FE_IIBB_SNAPSHOT_TTL_SECONDS=86400
# Página HTTPS pública que apunta al puerto 8090 del portal-worker.
# HTTP sólo se acepta para localhost durante desarrollo.
ARCA_ENROLLMENT_BASE_URL=http://127.0.0.1:8090
ARCA_ENROLLMENT_ENABLED=true
ARCA_ENROLLMENT_BIND=0.0.0.0
ARCA_ENROLLMENT_PORT=8090
