# Identidad y acceso al bot
TELEGRAM_BOT_TOKEN=
BOT_ALLOWED_CHAT_IDS=
LOG_LEVEL=INFO

# Persistencia interna. En Docker/Coolify se fuerza a /data/tax_monitor.sqlite3.
TAX_MONITOR_DB=./data/contador_ai.sqlite3

# Cifrado de credenciales y tickets.
# Coolify: cargar SESSION_ENCRYPTION_KEY como variable secreta.
# Local: dejarla vacía y usar el archivo indicado.
SESSION_ENCRYPTION_KEY=
SESSION_ENCRYPTION_KEY_FILE=/run/local-secrets/session_encryption.key

# ARCA Web Services de producción.
ARCA_ENVIRONMENT=production
ARCA_OPERATOR_CUIT=
ARCA_CERTIFICATE_ALIAS=

# Coolify: cargar el contenido base64 de cada archivo como variable secreta.
ARCA_CERTIFICATE_B64=
ARCA_PRIVATE_KEY_B64=

# Local: usar los tres archivos conservados en secrets/.
ARCA_CERTIFICATE_PATH=/run/local-secrets/simplearcaprod_7d17b50e91a73602.crt
ARCA_PRIVATE_KEY_PATH=/run/local-secrets/simplearcaprod.key

# Facturación WSFE. El punto debe ser exclusivo de Webservices; nunca usar 00001.
ARCA_WSFE_POINT_OF_SALE=2
INVOICE_EMISSION_CHAT_IDS=
INVOICE_ISSUER_IIBB=

# Generación de VEP de Ingresos Brutos. Si la lista queda vacía, usa la lista
# de chats autorizados para facturar. Nunca guarda datos bancarios.
IIBB_PAYMENTS_ENABLED=true
IIBB_PAYMENT_CHAT_IDS=

# Consultas de portales sin API pública.
CCMA_ENABLED=true
CCMA_CHAT_IDS=
CCMA_SYNC_INTERVAL_SECONDS=21600
CCMA_SNAPSHOT_TTL_SECONDS=86400
CCMA_BROWSER_HEADLESS=true
ARCA_SETI_ENABLED=true
ARCA_SETI_SNAPSHOT_TTL_SECONDS=86400
SANTA_FE_IIBB_ENABLED=true
SANTA_FE_IIBB_SNAPSHOT_TTL_SECONDS=86400

# Enlace de emergencia a noVNC, accesible únicamente por Tailscale.
CCMA_LOGIN_URL=

# Avisos automáticos.
AUTOMATIC_MONITOR_ENABLED=true
AUTOMATIC_MONITOR_CHECK_SECONDS=300
AUTOMATIC_SYNC_INTERVAL_SECONDS=21600

# Alta de CUIT y clave fiscal.
# En producción usar una IP 100.64.0.0/10 o un nombre completo *.ts.net.
ARCA_ENROLLMENT_BASE_URL=http://100.64.0.1:8090
ARCA_ENROLLMENT_ALLOW_TAILSCALE_HTTP=true
ARCA_ENROLLMENT_ENABLED=true

# IP de Tailscale asignada a la VPS. Docker publica sólo en esta interfaz.
TAILSCALE_BIND_IP=100.64.0.1
ARCA_ENROLLMENT_HOST_PORT=8090
CCMA_NOVNC_HOST_PORT=6080
